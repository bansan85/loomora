{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 13, "patch": 0 },
  "configurePresets": [
    {
      "name": "host-gcc",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/host-gcc",
      "cacheVariables": { "CMAKE_C_COMPILER": "gcc", "CMAKE_CXX_COMPILER": "g++" }
    },
    {
      "name": "host-clang",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/host-clang",
      "cacheVariables": { "CMAKE_C_COMPILER": "clang", "CMAKE_CXX_COMPILER": "clang++" }
    },
    {
      "name": "host-msvc",
      "description": "MSVC of Visual Studio 2026, x64: loomora.dll for the WinUI 3 UI (/MT)",
      "generator": "Visual Studio 18 2026",
      "architecture": { "value": "x64", "strategy": "set" },
      "binaryDir": "${sourceDir}/build/host-msvc",
      "cacheVariables": {
        "LOOMORA_BUILD_SHARED": "ON",
        "LOOMORA_BUILD_WIN32_LEGACY": "OFF",
        "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreaded$<$<CONFIG:Debug>:Debug>"
      }
    },
    {
      "name": "host-msvc-arm64",
      "description": "MSVC of Visual Studio 2026, ARM64 (needs the MSVC ARM64 build tools): loomora.dll for the WinUI 3 UI (/MT)",
      "inherits": "host-msvc",
      "architecture": { "value": "ARM64", "strategy": "set" },
      "binaryDir": "${sourceDir}/build/host-msvc-arm64",
      "cacheVariables": { "LOOMORA_BUILD_TESTS": "OFF" }
    },
    {
      "name": "web-wasm",
      "description": "Emscripten (emsdk_env.sh sourced), WebAssembly: loomora.js + loomora.wasm and loomora_selftest.js (run by node)",
      "generator": "Ninja",
      "binaryDir": "$env{HOME}/loomora-build/web-wasm",
      "toolchainFile": "${sourceDir}/cmake/toolchains/emscripten-wasm.cmake",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release", "LOOMORA_BUILD_CATCH2_TESTS": "OFF" }
    },
    {
      "name": "web-js",
      "description": "Emscripten (emsdk_env.sh sourced), JavaScript only (-sWASM=0 -sLEGACY_VM_SUPPORT=1): loomora.js and loomora_selftest.js (run by node)",
      "inherits": "web-wasm",
      "binaryDir": "$env{HOME}/loomora-build/web-js",
      "toolchainFile": "${sourceDir}/cmake/toolchains/emscripten-js.cmake"
    }
  ],
  "buildPresets": [
    { "name": "host-gcc", "configurePreset": "host-gcc" },
    { "name": "host-clang", "configurePreset": "host-clang" },
    { "name": "host-msvc", "configurePreset": "host-msvc", "configuration": "Release" },
    { "name": "host-msvc-arm64", "configurePreset": "host-msvc-arm64", "configuration": "Release" },
    { "name": "web-wasm", "configurePreset": "web-wasm" },
    { "name": "web-js", "configurePreset": "web-js" }
  ],
  "testPresets": [
    { "name": "host-msvc", "configurePreset": "host-msvc", "configuration": "Release" }
  ]
}
