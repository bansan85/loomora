<?xml version="1.0" encoding="utf-8"?>
<!-- Loomora Legacy UI for Android: API 9 (Android 2.3) and later, plain framework views, no
     AndroidX. No permission: the probe line goes to logcat and nothing is written or sent. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="fr.loomora.probe"
    android:versionCode="1"
    android:versionName="1.0">
    <uses-sdk android:minSdkVersion="9" android:targetSdkVersion="23" />
    <application android:label="Loomora" android:allowBackup="false">
        <activity android:name=".MainActivity" android:label="Loomora" android:exported="true"
            android:configChanges="orientation|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
