<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="LoomoraMauiSpike.MainPage"
             Title="Loomora MAUI spike">
    <VerticalStackLayout Padding="16" Spacing="12">
        <Label x:Name="AbiLabel" FontSize="14" />
        <Entry x:Name="NameEntry" Placeholder="Nom" />
        <Button Text="Dire bonjour (backend)" Clicked="OnGreetClicked" />
        <Label x:Name="GreetLabel" FontSize="18" />
    </VerticalStackLayout>
</ContentPage>
